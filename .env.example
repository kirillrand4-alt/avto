# Порт веб-панели. Поставь СВОБОДНЫЙ порт на сервере (проверь netstat).
PORT=8090

# Базовый путь за обратным прокси. Должен совпадать с location в nginx/прокси.
BASE_PATH=/avto

# Слушать только локалхост (рекомендуется, если впереди стоит nginx-прокси).
# Поставь 0.0.0.0, если заходишь напрямую по IP:PORT без прокси.
HOST=127.0.0.1

# Логин/пароль для входа в панель (HTTP Basic). ОБЯЗАТЕЛЬНО смени.
ADMIN_USER=admin
ADMIN_PASS=changeme

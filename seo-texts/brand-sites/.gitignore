# Логи прогонов: воспроизводимы, в историю не нужны
*.log

# Номер живого процесса конвейера. Смысла вне текущего запуска не имеет,
# а меняется при каждом перезапуске - в истории это чистый шум.
# Журнал konveyer.jsonl, наоборот, под git обязательно: это единственная
# запись прогона, переживающая откат песочницы.
konveyer.pid
peregon.log

# Сводка конвейера: целиком выводится из konveyer.jsonl, который
# под git и есть. Отдельной ценности не несёт, а переписывается
# после КАЖДОЙ страницы - в истории это шум, который заслоняет
# настоящие изменения.
konveyer-sostoyanie.json

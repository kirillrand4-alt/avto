# Пример env-файла для службы панели (systemd EnvironmentFile / NSSM AppEnvironmentExtra).
# СКОПИРУЙТЕ в /opt/rusprom-sender/panel.env и заполните РЕАЛЬНЫМИ значениями.
# НЕ коммитить заполненный файл — только этот .example с именами переменных.
# Права: chmod 600 panel.env; chown rusprom:rusprom panel.env  (там секреты).

# Путь к боевому конфигу (иначе serve-api возьмёт ./sender.yaml).
SENDER_CONFIG=/opt/rusprom-sender/sender.yaml

# Секрет подписи токенов отписки (>=32 байта). Общий с движком/unsub-сервером.
UNSUB_SIGNING_SECRET=

# Пароли SMTP-ящиков, на которые ссылается sender.yaml (password_env: BOX1_PASSWORD ...).
# Число и имена — по вашему конфигу; пример на 5 ящиков:
BOX1_PASSWORD=
BOX2_PASSWORD=
BOX3_PASSWORD=
BOX4_PASSWORD=
BOX5_PASSWORD=

# Интеграции (если панель/движок их читают): токен входящего вебхука Bitrix,
# токен Telegram-бота уведомлений, токен Postoffice Mail.ru. Оставьте пустыми,
# если не используются в этом процессе.
# BITRIX_WEBHOOK_TOKEN=
# TELEGRAM_BOT_TOKEN=
# POSTOFFICE_TOKEN=

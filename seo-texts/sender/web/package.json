    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "happy-dom": "^15.7.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"

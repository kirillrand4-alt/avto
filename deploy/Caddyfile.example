# На сервере обратный прокси — Caddy (слушает 80/443, админка на :2019).
# Нужно отдать панель на parsercompressor.online/avto, НЕ трогая другие проекты.
#
# Добавь блок `handle /avto/*` ВНУТРЬ существующего site-блока
# parsercompressor.online в твоём Caddyfile. `handle` (не `handle_path`)
# сохраняет префикс /avto — приложение само смонтировано на /avto.

parsercompressor.online {
    # ... здесь уже есть твои существующие маршруты к другим проектам ...
    # (например reverse_proxy на 127.0.0.1:8001 / :8011 / :5000)

    # --- панель авто-индексации ---
    handle /avto/* {
        reverse_proxy 127.0.0.1:8090
    }
}

# Если текущий конфиг использует общий `reverse_proxy` без `handle`-блоков,
# заверни существующий маршрут и новый в отдельные handle, иначе Caddy
# не даст смешивать. Пришли свой Caddyfile — подскажу точное место вставки.
#
# После правки:  caddy reload   (или перезапуск службы Caddy)
